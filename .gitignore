build/
build-*/
out/
.cache/
compile_commands.json
*.o
*.obj
*.exe
*.a
*.lib
*.so
*.dll
*.pdb

# CUDA build artifacts (src/solver/gpu, built only under SOVSOLVE_ENABLE_CUDA).
*.ptx
*.cubin
*.fatbin
.vs/
.vscode/
.idea/
CMakeUserPresets.json

# Benchmark corpora are fetched by scripts/fetch_netlib.py, not committed --
# the full set is several MB. afiro and adlittle are the exceptions: they are
# small, and committing them keeps the corpus test meaningful with no network.
tests/data/netlib/*.mps
!tests/data/netlib/afiro.mps
!tests/data/netlib/adlittle.mps
tests/data/miplib/
tests/data/qplib/
# Same rule for tests/data/lp/: it holds a large third-party instance set used
# only for ad-hoc reader checks. blend.lp is the exception, force-added because
# lp_reader_test needs it and it is tiny.
tests/data/lp/
!tests/data/lp/blend.lp
bench/results/*.json
bench/results/*.csv

# Oracle cross-check output (regenerated).
tests/oracle/*.json
__pycache__/
*.pyc
.venv/
# Team handover / explainer pages. Generated for onboarding and shared as a
# link; the repo's own docs/ directory is the tracked source of truth.
*.handover.html
handover/
docs/handover/

# Vendored third-party solvers, kept locally as CORRECTNESS ORACLES and
# reference corpora only -- never linked, never built, never committed, and
# their solver sources deliberately NOT read (PS 26119: "shall not be built
# upon any existing open source solver library"). See docs/HIGHS-COMPARISON.md.
#   HiGHS/    -- oracle via scripts/oracle_check.py (SciPy wraps it)
#   or-tools/ -- GLOP/PDLP/CP-SAT, cross-check via scripts/compare_solvers.py
or-tools/
HIGHS/

