# Build trees and compiler output
build/
build-*/
out/
.cache/
compile_commands.json
*.o
*.obj
*.exe
*.a
*.lib
*.so
*.dll
*.pdb

# CUDA build artifacts (src/solver/gpu, built only under SOVSOLVE_ENABLE_CUDA).
*.ptx
*.cubin
*.fatbin

# Editors
.vs/
.vscode/
.idea/
CMakeUserPresets.json

# Test data. Only what the test suite reads is committed: the 19 small Netlib
# models in tests/data/netlib/ (3.3 MB) and tests/data/lp/blend.lp, so that
# clone -> build -> ctest passes with no network. Everything else under
# tests/data/ -- the full Netlib set (scripts/fetch_netlib.py), MIPLIB, QPLIB,
# the Mittelmann LPs, archives -- is third-party, large, and dropped in by hand.
tests/data/*
!tests/data/netlib/
!tests/data/lp/
tests/data/lp/*
!tests/data/lp/blend.lp
bench/results/*.json
bench/results/*.csv

# Oracle cross-check output (regenerated).
tests/oracle/*.json

# Python
__pycache__/
*.pyc
.venv/

# Team handover / explainer pages, and local run notebooks (A100 benchmark).
*.handover.html
handover/
docs/handover/
notebooks/

# Third-party solvers kept locally as CORRECTNESS ORACLES only -- never linked,
# never built, never committed, and their sources deliberately NOT read
# (PS 26119: "shall not be built upon any existing open source solver
# library"). See docs/HIGHS-COMPARISON.md.
#   HiGHS/    -- oracle via scripts/oracle_check.py (SciPy wraps it)
#   or-tools/ -- GLOP/PDLP/CP-SAT, cross-check via scripts/compare_solvers.py
or-tools/
HIGHS/

# Ad-hoc benchmark CSVs written to the repository root. The runs we publish
# live in results/.
/*.csv

# Run by-products: CTest's scratch output, HiGHS's log when it is run as an
# oracle from the repository root, and bench_suite.py's lock files.
Testing/
Highs.log
*.lock
